MAX_BOT_TOKEN=replace_me
MAX_API_BASE=https://platform-api2.max.ru
MAX_TRANSPORT=polling
HTTPX_TRUST_ENV=false
APP_HOST=127.0.0.1
APP_PORT=8000
USERS_FILE=bot_users.json
# Replace all five sample chat IDs before starting. Use your own MAX test chats.
DEPARTMENT_CHAT_ID_ECONOMIC_SECURITY=-100000000001
DEPARTMENT_CHAT_ID_STORE_SECURITY=-100000000002
DEPARTMENT_CHAT_ID_LOGISTICS_SECURITY=-100000000003
DEPARTMENT_CHAT_ID_INFORMATION_SECURITY=-100000000004
DEPARTMENT_CHAT_ID_SECURITY_MANAGEMENT=-100000000005
# Comma-separated MAX user IDs allowed to answer appeals from service chats.
SPECIALIST_IDS=
# Optional contact label shown to applicants after selecting a department.
